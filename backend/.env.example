# Copia este archivo como .env y ajusta los valores.

# ── Conexión MT5 ────────────────────────────────────────────────────────
# Vacío = usa la cuenta que ya tenga abierta el terminal MT5.
# Admiral demo típico: AdmiralsSC-Demo  ·  real: AdmiralsSC-Live
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
# Ruta al terminal si no está en C:\Program Files\...
MT5_PATH=
# Hora del servidor respecto a UTC (Admirals: 3 en verano, 2 en invierno).
# Vacío = se detecta sola con el mercado abierto.
MT5_SERVER_UTC_OFFSET_HOURS=

# Traducciones manuales de símbolos (normalmente se detectan solas)
# SYMBOL_MAP=XAUUSD=GOLD-T,US500=#SPXC-T
SYMBOL_MAP=

# ── Seguridad ───────────────────────────────────────────────────────────
# El bot se niega a operar en cuentas REALES salvo que esto sea true.
ALLOW_REAL_ACCOUNT=false
# Identificador de las órdenes del bot (para distinguirlas de las manuales)
BOT_MAGIC=234000

# ── Base de datos PostgreSQL ────────────────────────────────────────────
# Vacío = SQLite en data/tradebot.db (solo para pruebas rápidas)
DATABASE_URL=postgresql+psycopg://postgres:CLAVE@127.0.0.1:5432/tradebot
# Base dedicada a los tests (se vacía en cada ejecución). Opcional.
TEST_DATABASE_URL=

# ── API ─────────────────────────────────────────────────────────────────
API_HOST=127.0.0.1
API_PORT=5000
# Orígenes del frontend autorizados (CORS), separados por coma
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Firma de las sesiones de usuario (vacío = se genera una y se guarda en la base de datos)
SECRET_KEY=
# Token de servicio para el EA TradeBotRemote, el vigilante y scripts (cabecera X-API-Token)
API_TOKEN=

# ── Alertas Telegram (opcional) ─────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Prefijo de los mensajes, útil con varios VPS
INSTANCE_NAME=

# ── Probador de Estrategias ─────────────────────────────────────────────
# Segundo MT5 en modo portable para lanzar el Probador automáticamente
# MT5_TESTER_PATH=C:\MT5Tester\terminal64.exe
MT5_TESTER_PATH=
# Carpeta Common\Files de MT5 (vacío = autodetectar)
MT5_COMMON_FILES=

# Carpeta de datos (base de datos, logs, caché, modelos, informes)
DATA_DIR=
